# Version control and editor/tooling state — irrelevant to the built image,
# and would otherwise invalidate Docker's build cache on every unrelated change.
.git
.claude
.pytest_cache
__pycache__
**/__pycache__
*.pyc

# Local-only artifacts: an egg-info from `pip install -e .`, and this
# project's own venv if one exists on disk.
poker_engine.egg-info
.venv
venv

# The frontend SOURCE stays in the build context (stage 1 needs it), but
# not its installed deps or any locally-built output — the build stage
# runs its own `npm ci` and `npm run build` from scratch every time.
frontend/node_modules
frontend/dist

# Tests aren't part of the runtime image — smaller image, smaller attack surface.
tests

# Not needed inside the container itself.
docker-compose.yml
Dockerfile
.dockerignore
